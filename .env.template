# ====================================
# FIREBASE CONFIGURATION TEMPLATE
# ====================================
# 
# 1. Go to: https://console.firebase.google.com/
# 2. Select your project
# 3. Click gear icon → Project settings
# 4. Scroll to "Your apps" → Web app
# 5. Copy the values below
#
# Replace the placeholder values with your actual Firebase config
# ====================================

VITE_API_BASE_URL=http://localhost:3000

# Firebase Web App Config (from Project Settings)
VITE_FIREBASE_API_KEY=paste_your_apiKey_here
VITE_FIREBASE_AUTH_DOMAIN=paste_your_authDomain_here
VITE_FIREBASE_PROJECT_ID=paste_your_projectId_here
VITE_FIREBASE_MESSAGING_SENDER_ID=paste_your_messagingSenderId_here
VITE_FIREBASE_APP_ID=paste_your_appId_here

# Firebase Cloud Messaging VAPID Key
# (from Project Settings → Cloud Messaging → Web Push certificates → Generate key pair)
VITE_FIREBASE_VAPID_KEY=paste_your_vapidKey_here

# ====================================
# EXAMPLE (DO NOT USE THESE VALUES):
# ====================================
# VITE_FIREBASE_API_KEY=AIzaSyD8X9X9X9X9X9X9X9X9X9X9X9X9X9X
# VITE_FIREBASE_AUTH_DOMAIN=my-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=my-project-12345
# VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
# VITE_FIREBASE_APP_ID=1:123456789012:web:abc123def456
# VITE_FIREBASE_VAPID_KEY=BPQx...very_long_key...xyz
